############################################################################
# Contest 2026 team 441 vision badge - Make.defs
############################################################################

ifneq ($(filter y,$(CONFIG_LVX_USE_DEMO_CONTEST2026_441_VISION_BADGE) \
                    $(CONFIG_LVX_USE_DEMO_CONTEST2026_441_VISION_BADGE_CLIENT)),)
CONFIGURED_APPS += $(APPDIR)/system/contest2026_441_vision_badge
else ifneq ($(CONFIG_LVX_USE_DEMO_CONTEST2026_441_R1_KEYLED),)
CONFIGURED_APPS += $(APPDIR)/system/contest2026_441_vision_badge
endif
