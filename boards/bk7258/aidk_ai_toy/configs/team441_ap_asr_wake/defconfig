# Team 441 final AP baseline: physical CPU1+CPU2 SMP NuttX/OpenVela.
# CONFIG_DEV_CONSOLE is not set
# CONFIG_MMCSD_HAVE_CARDDETECT is not set
# CONFIG_MMCSD_HAVE_WRITEPROTECT is not set
# CONFIG_MMCSD_MMCSUPPORT is not set
CONFIG_MMCSD_MULTIBLOCK_LIMIT=16
CONFIG_MMCSD_READ_MULTIBLOCK_LIMIT=1
CONFIG_MMCSD_SDIO_NO_PREERASE=y
CONFIG_MMCSD_CHECK_READY_STATUS_WITHOUT_SLEEP=y
CONFIG_SDIO_BLOCKSETUP=y
CONFIG_ALLOW_BSD_COMPONENTS=y
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../vendor/beken/boards/bk7258/aidk_ai_toy"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="aidk_ai_toy"
CONFIG_ARCH_CHIP_ARM_CUSTOM=y
CONFIG_ARCH_CHIP_BK7258=y
CONFIG_ARCH_CHIP_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM_DIR="../vendor/beken/chips/bk7258"
CONFIG_ARCH_CHIP_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_CHIP_CUSTOM_NAME="bk7258"
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_BK7258_AP_CORE=y
CONFIG_BK7258_AP_IPI=y
CONFIG_BK7258_AP_SMP_BOOTSTRAP=y
CONFIG_BK7258_AP_SMP_SCHED_ONLINE=y
CONFIG_BK7258_AP_SUPERVISOR=y
CONFIG_BK7258_BOARD_AIDK_AI_TOY=y
CONFIG_BK7258_PM_CLOCK=y
CONFIG_BK7258_PSRAM=y
CONFIG_BK7258_PSRAM_MEDIA=y
CONFIG_BK7258_PSRAM_SYSTEM_HEAP=y
CONFIG_BK7258_PSRAM_SYSTEM_HEAP_SIZE=0x80000
CONFIG_BK7258_PSRAM_EXT_SYSTEM_HEAP=y
CONFIG_BK7258_PSRAM_EXT_SYSTEM_HEAP_SIZE=0x400000
CONFIG_BK7258_SDK_SRAM_HEAP=y
CONFIG_BK7258_SDK_SRAM_HEAP_SIZE=0x4000
CONFIG_BK7258_RPTUN=y
CONFIG_BK7258_RPTUN_LAYOUT=y
CONFIG_BK7258_RPTUN_MBOX=y
CONFIG_BK7258_PM_COORDINATED_STANDBY=y
CONFIG_BK7258_WIFI_VNET=y
CONFIG_BK7258_AIDK_DUAL_LCD=y
CONFIG_LCD_GC9D01_NINTERFACES=2
CONFIG_BK7258_DVP=y
CONFIG_BK7258_AIDK_CAMERA=y
CONFIG_BK7258_AIDK_BSP_SELFTEST=y
CONFIG_BK7258_TRNG=y
CONFIG_MBEDTLS_ENTROPY_HARDWARE_ALT=y
CONFIG_LVX_USE_DEMO_CONTEST2026_441_VISION_BADGE=y
CONFIG_CONTEST2026_441_AGORA=y
CONFIG_PIPES=y
CONFIG_DEV_PIPE_SIZE=1024
# CONFIG_CONTEST2026_441_XIAOZHI is not set
# CONFIG_LIB_OPUS is not set
# CONFIG_OPENSSL_MBEDTLS_WRAPPER is not set
# CONFIG_NETUTILS_LIBWEBSOCKETS is not set
CONFIG_NET_TCPPROTO_OPTIONS=y
# CONFIG_NETUTILS_LIBWEBSOCKETS_TLS is not set
CONFIG_CONTEST2026_441_VISION_BADGE_STACKSIZE=8192
CONFIG_CONTEST2026_441_VISION_BADGE_JPEG_BUFFER_SIZE=262144
CONFIG_CONTEST2026_441_VISION_BADGE_RESULT_BUFFER_SIZE=32768
CONFIG_BK7258_AUD=y
CONFIG_BK7258_MIC=y
CONFIG_BK7258_MIC_STACKSIZE=8192
CONFIG_BK7258_AIDK_SD_NAND=y
CONFIG_BK7258_AIDK_BATTERY=y
CONFIG_BK7258_SARADC_CHAN=0
CONFIG_BK7258_SARADC_BUS=0
CONFIG_BK7258_SARADC_READ_TIMEOUT_MS=1000
CONFIG_BK7258_SDIO_4BIT=y
CONFIG_BK7258_STORAGE_FIXED_BLOCK=y
CONFIG_BK7258_I2C=y
CONFIG_BK7258_I2C_BUS=0
CONFIG_FS_FAT=y
CONFIG_FAT_LFN=y
CONFIG_FS_PROCFS=y
CONFIG_FS_PROCFS_REGISTER=y
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYPOINT="bk7258_ap_main"
CONFIG_MM_REGIONS=3
CONFIG_NET=y
# Keep bounded Agora diagnostics; repeated kernel allocation errors consume
# the same IOB pool through SYSLOG_BUFFER and amplify a pool shortage.
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_ERROR=y
# CONFIG_DEBUG_WARN is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_NET=y
# CONFIG_DEBUG_NET_ERROR is not set
# CONFIG_DEBUG_NET_WARN is not set
# CONFIG_DEBUG_NET_INFO is not set
# Keep the baseline stack policy; DEBUG_FEATURES must not change it implicitly.
CONFIG_ARMV8M_STACKCHECK_NONE=y
# IOB_DEBUG is incompatible with SYSLOG_BUFFER (the logger itself uses IOBs).
# Keep buffered cross-core logging; Agora records first errors and IOB
# availability without a new log line for every exhausted allocation.
# CONFIG_IOB_DEBUG is not set
# RTC load exhausted the old 36-IOB pool and returned to 35 free after stop.
# Budget 128 x 208-byte IOB objects (196-byte payload); +19136 SRAM bytes.
# Bound per-socket queues while retaining the old generic ICMP chain count.
CONFIG_IOB_NBUFFERS=128
CONFIG_IOB_NCHAINS=36
CONFIG_NET_RECV_BUFSIZE=4096
CONFIG_NET_SEND_BUFSIZE=4096
# Full Ethernet frame without FCS: 14-byte header + 1500-byte IP MTU.
# RTC UDP datagrams must not inherit NuttX's 590-byte IPv4 minimum.
CONFIG_NET_ETH_PKTSIZE=1514
# Allow the cross-core Wi-Fi/phone-hotspot ARP round trip up to 200 ms.
# Default 5 tries are retained; do not replay non-idempotent HTTP POSTs.
CONFIG_ARP_SEND_DELAYMSEC=200
CONFIG_NET_LOOPBACK=y
CONFIG_NETDB_DNSCLIENT=y
CONFIG_NETDB_DNSCLIENT_RECV_TIMEOUT=2
CONFIG_NETDB_DNSCLIENT_RETRIES=8
CONFIG_NETDEV_IFINDEX=y
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_TCP=y
CONFIG_NET_TCP_WRITE_BUFFERS=y
CONFIG_NET_UDP=y
CONFIG_NET_UDP_ALLOC_CONNS=1
CONFIG_NET_UDP_MAX_CONNS=16
CONFIG_NET_UDP_WRITE_BUFFERS=y
CONFIG_PM_NDOMAINS=3
CONFIG_RAW_BINARY=y
CONFIG_RPTUN_AUTO_RESET_DISABLE=y
CONFIG_RR_INTERVAL=200
CONFIG_SCHED_HPWORK=y
CONFIG_SMP=y
CONFIG_SMP_DEFAULT_CPUSET=0x1
CONFIG_SMP_NCPUS=2
CONFIG_SYSLOG_BUFFER=y
CONFIG_SYSLOG_INTBUFFER=y
CONFIG_SYSLOG_INTBUFSIZE=512
CONFIG_SYSLOG_PREFIX=y
CONFIG_SYSLOG_PREFIX_STRING="ap"
CONFIG_SYSLOG_PRIORITY=y
CONFIG_SYSLOG_PROCESSID=y
CONFIG_SYSLOG_RPMSG=y
CONFIG_SYSLOG_RPMSG_BUFSIZE=1024
CONFIG_SYSLOG_RPMSG_SERVER_NAME="cp"
CONFIG_SYSLOG_RPMSG_WORK_DELAY=20
CONFIG_SYSLOG_TIMESTAMP=y
CONFIG_SYSTEM_TIME64=y

# Optional OpenVela LVGL candidate; baseline remains team441_ap.
CONFIG_GRAPHICS_LVGL=y
CONFIG_BK7258_AIDK_EYE_LVGL_STATUS=y
CONFIG_LV_CONF_MINIMAL=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=16
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_LABEL=y
# CONFIG_LV_USE_NUTTX is not set
# CONFIG_LV_USE_THEME_DEFAULT is not set
# CONFIG_LV_USE_THEME_SIMPLE is not set
# CONFIG_LV_BUILD_EXAMPLES is not set

# Explicit power candidate; no automatic shutdown.
CONFIG_BK7258_PM_SOFT_OFF=y
CONFIG_CONTEST2026_441_POWER=y

# RTC socket polling and HTTP camera control share this fixed NuttX pool.
# Keep allocations bounded; diagnose EBUSY with AP /proc/mempool snapshots.
CONFIG_NET_PREALLOC_DEVIF_CALLBACKS=32
CONFIG_NET_ALLOC_DEVIF_CALLBACKS=0

# Optional LAN ASR wake; no C++/TFLM weights in the AP image.
CONFIG_CONTEST2026_441_WAKE_ASR=y
CONFIG_CONTEST2026_441_WAKE=y
