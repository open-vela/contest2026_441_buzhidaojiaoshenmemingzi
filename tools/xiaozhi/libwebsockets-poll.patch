diff --git a/netutils/libwebsockets/Kconfig b/netutils/libwebsockets/Kconfig
--- a/netutils/libwebsockets/Kconfig
+++ b/netutils/libwebsockets/Kconfig
@@ -16,6 +16,12 @@ config NETUTILS_LIBWEBSOCKETS_TEST
 
 if NETUTILS_LIBWEBSOCKETS
 
+config NETUTILS_LIBWEBSOCKETS_TLS
+	bool "Enable libwebsockets TLS backend"
+	default y
+	help
+		Disable only for explicitly configured local-network ws:// clients.
+
 config NETUTILS_LIBWEBSOCKETS_VERSION
 	string "Version number"
 	default "4.3.1"
